import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        int num = 1; // 1부터 시작하는 숫자 변수
        
        // 바깥쪽 반복문: 행 (0부터 n-1까지)
        for (int i = 0; i < n; i++) {
            
            // 1. 공백 출력 (행이 바뀔 때마다 2칸씩 늘어남: i * 2 개)
            for (int j = 0; j < i * 2; j++) {
                System.out.print(" ");
            }
            
            // 2. 숫자 출력 (각 행마다 n - i 개씩 출력)
            for (int j = 0; j < n - i; j++) {
                System.out.print(num + " ");
                num++; // 숫자를 출력할 때마다 1씩 증가
            }
            
            // 3. 줄바꿈
            System.out.println();
        }
    }
}
