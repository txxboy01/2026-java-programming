import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        // n줄 만큼 반복
        for (int i = 0; i < n; i++) {
            // 1. 공백 출력 ((n - 1 - i) * 2 개)
            for (int j = 0; j < (n - 1 - i) * 2; j++) {
                System.out.print(" ");
            }
            
            // 2. 별 출력 (2 * i + 1 개)
            for (int j = 0; j < 2 * i + 1; j++) {
                System.out.print("*");
            }
            
            // 3. 줄바꿈
            System.out.println();
        }
    }
}