import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        // n줄 만큼 반복
        for (int i = 0; i < n; i++) {
            // 1. 공백 출력 ((n - 1 - i) * 2 개)
            for (int j = 0; j < (n - 1 - i) * 2; j++) {
                System.out.print(" ");
            }
            
            // 2. 숫자 출력 (1부터 i + 1까지, 공백으로 구분)
            for (int j = 1; j <= i + 1; j++) {
                System.out.print(j + " ");
            }
            
            // 3. 줄바꿈
            System.out.println();
        }
    }
}