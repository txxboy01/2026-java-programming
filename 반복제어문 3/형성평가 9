import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        // 1. 상단부 (1개부터 n개까지 늘어남)
        for (int i = 1; i <= n; i++) {
            // '#' 출력 (사이마다 공백 포함)
            for (int j = 0; j < i; j++) {
                System.out.print("# ");
            }
            System.out.println();
        }
        
        // 2. 하단부 (n-1개부터 1개까지 줄어들고 들여쓰기 발생)
        for (int i = n - 1; i >= 1; i--) {
            // 공백 출력 (줄이 내려갈수록 2칸씩 증가: (n - i) * 2 개)
            for (int j = 0; j < (n - i) * 2; j++) {
                System.out.print(" ");
            }
            
            // '#' 출력
            for (int j = 0; j < i; j++) {
                System.out.print("# ");
            }
            System.out.println();
        }
    }
}