import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int count = 0; // 3과 5의 배수를 제외한 수의 개수를 셀 변수
        
        while (true) {
            int num = sc.nextInt();
            
            // 0이 입력되면 반복문 탈출
            if (num == 0) {
                break;
            }
            
            // 3의 배수도 아니고 5의 배수도 아닌 경우
            if (num % 3 != 0 && num % 5 != 0) {
                count++;
            }
        }
        
        // 최종 개수 출력
        System.out.println(count);
    }
}