import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        // 1부터 10까지 반복하며 n의 배수를 차례대로 출력
        for (int i = 1; i <= 10; i++) {
            System.out.print((n * i) + " ");
        }
    }
}
