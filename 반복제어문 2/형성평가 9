import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        
        // 바깥쪽 반복문: 첫 번째 숫자 (1부터 n까지)
        for (int i = 1; i <= n; i++) {
            // 안쪽 반복문: 두 번째 숫자 (1부터 n까지)
            for (int j = 1; j <= n; j++) {
                // 출력 형식: (i, j) 뒤에 공백 1칸
                System.out.print("(" + i + ", " + j + ") ");
            }
            // 한 행의 출력이 끝나면 줄바꿈
            System.out.println();
        }
    }
}