import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int sum = 0;   // 합계를 저장할 변수
        int count = 0; // 입력받은 숫자의 개수를 셀 변수
        
        while (true) {
            int num = sc.nextInt();
            
            // 0부터 100 사이의 범위를 벗어나면 반복문 탈출
            if (num < 0 || num > 100) {
                break;
            }
            
            sum += num;   // 합계에 누적
            count++;      // 개수 1 증가
        }
        
        // 평균 계산 (소수점 계산을 위해 double로 형변환)
        double avg = (double) sum / count;
        
        // 결과 출력 (sum은 정수, avg는 printf를 이용해 소수 첫째 자리까지 반올림 출력)
        System.out.println("sum : " + sum);
        System.out.printf("avg : %.1f\n", avg);
    }
}